# Copie para .env e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Use só a chave pública (anon/publishable).
# NUNCA coloque a service_role aqui: tudo com EXPO_PUBLIC_ vai para dentro do app.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sua-chave-publica
# Endereço onde a versão web do app está publicada (para o link de encomenda /e/<slug>).
EXPO_PUBLIC_WEB_URL=https://seu-dominio.com.br
# Opcional: troca o e-mail de contato da Política de privacidade (padrão gestaofacil.suporte@gmail.com).
EXPO_PUBLIC_CONTACT_EMAIL=
# Monitor de erros (Sentry): o "DSN" do projeto. Vazio = desligado.
EXPO_PUBLIC_SENTRY_DSN=
